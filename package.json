{
  "name": "playcounter",
  "version": "0.1.0",
  "private": true,
  "description": "Gametime tracker. Detects running games from any sources and tracks your play sessions locally.",
  "license": "MIT",
  "author": "zntr1",
  "homepage": "https://playcounter.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/zntr1/PlayCounter.git"
  },
  "bugs": {
    "url": "https://github.com/zntr1/PlayCounter/issues"
  },
  "packageManager": "pnpm@9.15.4",
  "pnpm": {
    "overrides": {
      "@babel/core@>=7 <7.29.6": "^7.29.6",
      "browserslist@>=4 <4.28.7": "^4.28.7",
      "postcss-selector-parser@>=6 <6.1.3": "^6.1.3"
    }
  },
  "scripts": {
    "dev": "turbo dev",
    "landing:build": "node scripts/landing/build.mjs",
    "landing:check": "node scripts/landing/build.mjs --check && node scripts/landing/check.mjs",
    "landing:preview": "node scripts/landing/preview.mjs",
    "desktop:version": "node scripts/ci/sync-desktop-version.mjs",
    "desktop:dev": "scripts\\dev-desktop.cmd",
    "desktop:build": "scripts\\build-desktop.cmd",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "turbo": "^2.5.3",
    "typescript": "^5.8.3"
  }
}
